# ─── App ───────────────────────────────────────────────
APP_NAME=Contract Intelligence System
APP_VERSION=1.0.0
APP_ENV=development

# ─── Database ──────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/contract-RAG

# ─── Security (JWT) ────────────────────────────────────
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── Qdrant ────────────────────────────────────────────
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=contracts

# ─── Cohere ────────────────────────────────────────────
COHERE_API_KEY=

# ─── LLM ───────────────────────────────────────────────
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# ─── File Upload ───────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=.pdf,.docx,.txt

# ─── Chunking ──────────────────────────────────────────
CHILD_CHUNK_WORDS=100
CHUNK_OVERLAP_SENTENCES=2